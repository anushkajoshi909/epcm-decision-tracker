# Copy this file to .env and fill in your university LLM API details.
# Any OpenAI-compatible endpoint works (OpenAI itself, Azure OpenAI, a
# LiteLLM/vLLM proxy, etc.) - the OpenAI Python SDK just needs a base_url.

LLM_BASE_URL=https://your-university-llm-endpoint/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Base URL of this FastAPI service, used by the eval script and n8n workflow.
APP_BASE_URL=http://127.0.0.1:8000
