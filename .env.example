# Defaults to the SCADS.AI endpoint (https://llm.scads.ai/v1), reading the
# API key from ~/.scadsai-api-key. Leave LLM_BASE_URL / LLM_API_KEY unset to
# use that; set them to point at a different OpenAI-compatible endpoint
# instead (OpenAI itself, Azure OpenAI, a LiteLLM/vLLM proxy, etc.).

LLM_BASE_URL=https://llm.scads.ai/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Base URL of this FastAPI service, used by the eval script and n8n workflow.
APP_BASE_URL=http://127.0.0.1:8000
