{
  "name": "EPCM Decision & Interface Action Tracker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "epcm-protocol",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook - Receive Protocol",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/analyse-protocol",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "http-request-node",
      "name": "Call FastAPI /analyse-protocol",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.requires_attention }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-node",
      "name": "IF requires_attention",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build a simple warning message from the FastAPI response.\n// In a real deployment this is where a Teams/Slack/email node would go.\nconst data = $input.first().json;\nconst issueLines = (data.issues || [])\n  .map((i) => `- [${i.severity.toUpperCase()}] ${i.type}: ${i.message}`)\n  .join('\\n');\n\nconst warning = `WARNING - project ${data.project_id} needs attention:\\n${issueLines}`;\nconsole.log(warning);\n\nreturn [{ json: { ...data, warning } }];"
      },
      "id": "code-node",
      "name": "Create Warning (log)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - Receive Protocol": {
      "main": [
        [
          {
            "node": "Call FastAPI /analyse-protocol",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call FastAPI /analyse-protocol": {
      "main": [
        [
          {
            "node": "IF requires_attention",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF requires_attention": {
      "main": [
        [
          {
            "node": "Create Warning (log)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Warning (log)": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
