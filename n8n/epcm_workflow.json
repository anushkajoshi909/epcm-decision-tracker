      "parameters": {
        "jsCode": "// Build a simple warning message from the FastAPI response.\nconst data = $input.first().json;\nconst issueLines = (data.issues || [])\n  .map((i) => `- [${i.severity.toUpperCase()}] ${i.type}: ${i.message}`)\n  .join('\\n');\n\nconst warning = `WARNING - project ${data.project_id} needs attention:\\n${issueLines}`;\nconsole.log(warning);\n\nreturn [{ json: { ...data, warning } }];"
